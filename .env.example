# ── Fal.ai — generative media (required) ─────────────────────────────────────
FAL_KEY=your-fal-api-key-here

# ── Vercel Blob — persistent storage in production (required on Vercel) ───────
# Provision from: Vercel Dashboard → Storage → Blob → Create Store
# The token is auto-injected when you link the store to your project.
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# ── OpenAI — Creative Copilot (optional) ──────────────────────────────────────
OPENAI_API_KEY=
